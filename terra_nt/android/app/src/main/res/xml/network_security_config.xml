<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to the device's own loopback: the planning server is reached through
     `adb reverse tcp:8787 tcp:8787` over USB (emulator and phone alike). Everything else,
     map tiles and Firebase included, stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
