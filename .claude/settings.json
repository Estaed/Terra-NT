{
  "extraKnownMarketplaces": {
    "dart-flutter": {
      "source": {
        "source": "github",
        "repo": "flutter/agent-plugins"
      }
    }
  },
  "enabledPlugins": {
    "dart-flutter@dart-flutter": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/brain-rules.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
